<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence Nomor Kontrak Sewa (SEWA/2026/001) -->
        <record id="seq_rental_contract" model="ir.sequence">
            <field name="name">Kode Kontrak Sewa</field>
            <field name="code">rental.contract</field>
            <field name="prefix">SEWA/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence Nomor Pembukuan Keuangan (ACC/2026/001) -->
        <record id="seq_rental_accounting" model="ir.sequence">
            <field name="name">Kode Pembukuan Keuangan</field>
            <field name="code">rental.accounting</field>
            <field name="prefix">ACC/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>