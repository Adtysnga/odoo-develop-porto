<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Master Rumah List & Form View -->
    <record id="view_rental_house_tree" model="ir.ui.view">
        <field name="name">rental.house.list</field>
        <field name="model">rental.house</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="house_type"/>
                <field name="address"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'available'" 
                       decoration-warning="status == 'rented'"/>
            </list>
        </field>
    </record>

    <record id="view_rental_house_form" model="ir.ui.view">
        <field name="name">rental.house.form</field>
        <field name="model">rental.house</field>
        <field name="arch" type="xml">
            <form string="Unit Rumah">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="misal: Rumah Tipe 36 - Blok A1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="house_type"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Search View Filter -->
    <record id="view_rental_contract_search" model="ir.ui.view">
        <field name="name">rental.contract.search</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <search string="Cari Data Sewa Rumah">
                <field name="tenant_name" string="Nama Penyewa"/>
                <field name="tenant_phone" string="No. WhatsApp"/>
                <field name="house_id" string="Unit Rumah"/>
                <field name="house_type" string="Tipe Rumah"/>
                <field name="payment_scheme" string="Skema Cicilan"/>
                <field name="state" string="Status Pembayaran"/>

                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Berjalan" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Jatuh Tempo" name="filter_overdue" domain="[('state', '=', 'overdue')]"/>
                <filter string="Lunas / Dibayar" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Selesai Kontrak" name="filter_done" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <!-- 3. Kanban View (Kartu Grid Menyamping Penuh Layar) -->
    <record id="view_rental_contract_kanban" model="ir.ui.view">
        <field name="name">rental.contract.kanban</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="tenant_name"/>
                <field name="house_id"/>
                <field name="amount"/>
                <field name="due_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 shadow-sm rounded-3 border-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="fs-5 text-primary"><field name="tenant_name"/></strong>
                                <field name="state" widget="badge" 
                                       decoration-muted="state == 'draft'"
                                       decoration-info="state == 'active'" 
                                       decoration-danger="state == 'overdue'" 
                                       decoration-success="state == 'paid'"
                                       decoration-warning="state == 'done'"/>
                            </div>
                            <div class="mt-2 text-muted">
                                <div>🏠 <field name="house_id"/></div>
                                <div>📅 Jatuh Tempo: <field name="due_date"/></div>
                                <div class="fw-bold text-success fs-6 mt-1">Rp <field name="amount"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 4. List View Kontrak Sewa -->
    <record id="view_rental_contract_tree" model="ir.ui.view">
        <field name="name">rental.contract.list</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tenant_name"/>
                <field name="tenant_phone"/>
                <field name="house_id"/>
                <field name="house_type"/>
                <field name="payment_scheme"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="state" widget="badge" 
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'active'" 
                       decoration-danger="state == 'overdue'" 
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- 5. Form View Kontrak Sewa (Dengan Tombol Selesai Kontrak) -->
    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">rental.contract.form</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <form string="Form Sewa Rumah">
                <header>
                    <button name="action_confirm" string="Konfirmasi Kontrak" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_to_paid" string="✔ Tandai Lunas / Dibayar" type="object" class="btn-success btn-lg" invisible="state in ('draft', 'paid', 'done')"/>
                    <button name="action_manual_send_wa" string="📲 Kirim Pesan WA Manual" type="object" class="btn-secondary" invisible="state == 'done'"/>
                    
                    <!-- Tombol Putus/Selesai Kontrak -->
                    <button name="action_terminate_contract" 
                            string="🛑 Selesai / Putus Kontrak" 
                            type="object" 
                            class="btn-danger" 
                            confirm="Apakah Anda yakin ingin menyelesaikan kontrak ini? Unit rumah akan kembali berstatus TERSEDIA." 
                            invisible="state in ('draft', 'done')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,active,overdue,paid,done"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <span class="o_form_label text-muted">Kode Kontrak</span>
                        <h1><field name="name" readonly="1" class="text-primary"/></h1>
                    </div>
                    
                    <div class="card p-3 mb-3 bg-light rounded-3 border-0">
                        <group>
                            <group string="👤 Data Penyewa">
                                <field name="tenant_name" placeholder="Nama Lengkap Penyewa" readonly="state != 'draft'"/>
                                <field name="tenant_phone" placeholder="Contoh: 628123456789" readonly="state != 'draft'"/>
                            </group>
                            <group string="🏠 Detail Rumah &amp; Sewa">
                                <field name="house_id" readonly="state != 'draft'"/>
                                <field name="house_type"/>
                                <field name="payment_scheme" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <field name="amount" readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </div>

                    <div class="card p-3 shadow-sm border-0 rounded-3 mb-3">
                        <group string="📅 Waktu Pembayaran">
                            <group><field name="start_date" readonly="state != 'draft'"/></group>
                            <group><field name="due_date" readonly="state != 'draft'"/></group>
                        </group>
                    </div>

                    <notebook>
                        <page string="📱 Riwayat Pengiriman WA">
                            <field name="wa_log_ids" readonly="1">
                                <list>
                                    <field name="send_date"/>
                                    <field name="phone"/>
                                    <field name="message"/>
                                    <field name="status" widget="badge" decoration-success="status == 'sent'" decoration-danger="status == 'failed'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 6. Pembukuan Keuangan Views (List & Form) -->
    <record id="view_rental_accounting_tree" model="ir.ui.view">
        <field name="name">rental.accounting.list</field>
        <field name="model">rental.accounting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_date"/>
                <field name="tenant_name"/>
                <field name="house_id"/>
                <field name="payment_method"/>
                <field name="amount" sum="Total Pemasukan"/>
            </list>
        </field>
    </record>

    <record id="view_rental_accounting_form" model="ir.ui.view">
        <field name="name">rental.accounting.form</field>
        <field name="model">rental.accounting</field>
        <field name="arch" type="xml">
            <form string="Detail Pembukuan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="tenant_name"/>
                            <field name="house_id"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="amount"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Catatan Pembukuan..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 7. Window Actions -->
    <record id="action_rental_contract" model="ir.actions.act_window">
        <field name="name">Pemantauan Sewa Rumah</field>
        <field name="res_model">rental.contract</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_rental_contract_search"/>
    </record>

    <record id="action_rental_house" model="ir.actions.act_window">
        <field name="name">Unit Rumah Sewa</field>
        <field name="res_model">rental.house</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rental_accounting" model="ir.actions.act_window">
        <field name="name">Pembukuan Keuangan</field>
        <field name="res_model">rental.accounting</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 8. Cron Job Pengingat WA -->
    <record id="ir_cron_auto_wa_rental_reminder" model="ir.cron">
        <field name="name">Sewa Rumah: Check &amp; Kirim Pengingat WA Otomatis</field>
        <field name="model_id" ref="model_rental_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_rental_payments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- 9. Menu Utama & Sub-Menu Navigasi -->
    <menuitem id="menu_rental_house_root" name="Sewa Rumah" sequence="10"/>

    <menuitem id="menu_rental_contract" 
              name="Pemantauan Sewa" 
              parent="menu_rental_house_root" 
              action="action_rental_contract" 
              sequence="10"/>

    <menuitem id="menu_rental_house_unit" 
              name="Master Unit Rumah" 
              parent="menu_rental_house_root" 
              action="action_rental_house" 
              sequence="20"/>

    <menuitem id="menu_rental_accounting"
              name="Pembukuan Keuangan"
              parent="menu_rental_house_root"
              action="action_rental_accounting"
              sequence="30"/>
</odoo>