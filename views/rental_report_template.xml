<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tombol Aksi Cetak Report PDF -->
    <record id="action_report_rental_accounting_pdf" model="ir.actions.report">
        <field name="name">Cetak Laporan Pembukuan (PDF)</field>
        <field name="model">rental.accounting</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_house_management.report_accounting_template</field>
        <field name="report_file">rental_house_management.report_accounting_template</field>
        <field name="binding_model_id" ref="model_rental_accounting"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template PDF Multi-Halaman -->
    <template id="report_accounting_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    
                    <!-- HALAMAN 1: KUITANSI UNTUK PENYEWA -->
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2><strong>BUKTI PEMBAYARAN SEWA RUMAH</strong></h2>
                            <p class="text-muted">No. Transaksi: <span t-field="doc.name"/></p>
                        </div>

                        <table class="table table-bordered mb-4">
                            <tr>
                                <td style="width: 30%;"><strong>Nama Penyewa</strong></td>
                                <td><span t-field="doc.tenant_name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Unit Properti</strong></td>
                                <td><span t-field="doc.house_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Tanggal Bayar</strong></td>
                                <td><span t-field="doc.payment_date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Metode Bayar</strong></td>
                                <td><span t-field="doc.payment_method"/></td>
                            </tr>
                            <tr>
                                <td><strong>Total Dibayar</strong></td>
                                <td><strong><span t-field="doc.amount" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></strong></td>
                            </tr>
                        </table>

                        <div class="row text-center mt-5">
                            <div class="col-6">
                                <p>Penyewa / Pembayar,</p>
                                <br/><br/>
                                <p>( <u><span t-field="doc.tenant_name"/></u> )</p>
                            </div>
                            <div class="col-6">
                                <p>Pengelola / Admin,</p>
                                <br/><br/>
                                <p>( _______________________ )</p>
                            </div>
                        </div>

                        <!-- PEMISAH HALAMAN BARU (PAGEBREAK) -->
                        <div class="pagebreak"/>

                        <!-- HALAMAN 2: CATATAN PEMBUKUAN INTERNAL -->
                        <div class="text-center mb-4 mt-3">
                            <h2><strong>LAMPIRAN PEMBUKUAN INTERNAL PENGELOLA</strong></h2>
                            <p class="text-muted">No. Arsip: <span t-field="doc.name"/></p>
                        </div>

                        <table class="table table-striped mb-4">
                            <thead>
                                <tr class="bg-secondary text-white">
                                    <th>Komponen Pembukuan</th>
                                    <th>Keterangan</th>
                                    <th class="text-end">Jumlah</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Pemasukan Sewa Clean</td>
                                    <td><span t-field="doc.notes"/></td>
                                    <td class="text-end"><span t-field="doc.amount" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="alert alert-info">
                            <strong>Catatan Pembukuan:</strong> Halaman ini merupakan arsip resmi pembukuan kas masuk pengelola properti.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>